# Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon) : LECTURE seule, inlinée dans le bundle navigateur.
# Sans risque tant que la RLS n'autorise que `select`
# (cf. supabase/migrations/0001_rls_lecture_seule.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role : SECRET. Contourne la RLS, ne doit JAMAIS être préfixée
# NEXT_PUBLIC_ (elle serait publiée dans le bundle). Sert à toutes les
# écritures (Server Actions de app/actions.ts, routes /api).
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe unique d'accès à l'app. Requis : sans lui l'app refuse de
# vérifier les sessions.
APP_PASSWORD=

# Clé de signature du cookie de session (ex. `openssl rand -base64 32`).
# Optionnelle : à défaut, dérivée d'APP_PASSWORD — changer le mot de passe
# invalide alors les sessions ouvertes.
AUTH_SECRET=

# Notifications push — VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Secret de la route cron (en-tête x-cron-secret). /api/cron est exclu du
# middleware : c'est ce secret qui la protège.
CRON_SECRET=

# Horloge simulée pour tester les notifications à la main (lib/time.ts), ex.
# 2026-09-24T08:02:00+02:00. Ignorée en production Vercel. Laisser vide.
DASHBOARD_FAKE_NOW=

# Santé du portfolio : jeton GitHub en LECTURE SEULE (fine-grained token,
# permissions « Contents: read » et « Metadata: read » sur mes dépôts).
# Facultatif : sans lui, seuls les dépôts publics sont lus (60 requêtes/h).
GITHUB_TOKEN=
