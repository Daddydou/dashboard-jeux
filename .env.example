# Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon) : LECTURE seule, inlinée dans le bundle navigateur.
# Sans risque tant que la RLS n'autorise que `select`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role : SECRET, jamais préfixée NEXT_PUBLIC_. Sert aux écritures
# (Server Actions de actions/jeux.ts, routes /api) et à la LECTURE des tables
# privées ttfl_* pour la carte TTFL.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe unique d'accès à l'app (obligatoire).
APP_PASSWORD=

# Clé de signature du cookie de session (ex. `openssl rand -base64 32`).
# Optionnelle : à défaut, dérivée d'APP_PASSWORD.
AUTH_SECRET=

# Notifications push — VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Secret de la route cron (en-tête x-cron-secret).
CRON_SECRET=

# Horloge simulée pour tester les rappels (lib/time.ts), ex.
# 2026-09-24T08:02:00+02:00. Ignorée en production. Laisser vide.
DASHBOARD_FAKE_NOW=

# Carte Pick + Bracket : clé de l'API Game Tracker (la même que l'app tennis,
# SECRET, type « sensitive » sur Vercel). Lue en GET uniquement. Vide : la
# carte n'affiche que la liste des tournois.
GAMETRACKER_PICKS_KEY=
